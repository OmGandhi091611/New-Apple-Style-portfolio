{
    "compilerOptions": {
        "paths": {
            "#components": ["./src/components"],
            "#components/*": ["./src/components/*"],
            "#constants": ["./src/constants"],
            "#constants/*": ["./src/constants/*"],
            "#lib": ["./src/lib"],
            "#lib/*": ["./src/lib/*"]
        }
    },
    "include": ["src"]
}